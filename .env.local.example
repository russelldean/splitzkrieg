# Azure SQL (used at build time and revalidation only; visitors never hit the DB)
AZURE_SQL_SERVER=splitzkrieg-sql.database.windows.net
AZURE_SQL_DATABASE=splitzkrieg
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=

# Revalidation (protect the /api/revalidate endpoint)
# Generate with: openssl rand -hex 32
REVALIDATION_SECRET=

# Resend (email notifications for feedback submissions)
RESEND_API_KEY=

# Public site URL (used for OG meta tags and share links)
NEXT_PUBLIC_SITE_URL=https://splitzkrieg.org

# Admin auth (/evillair)
# ADMIN_PASSWORD grants full admin; WRITER_PASSWORD grants blog-only access.
# Generate the JWT secret with: openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
WRITER_PASSWORD=

# Email sender + reply-to (Resend). Falls back to Splitzkrieg <noreply@splitzkrieg.com>.
RECAP_FROM_ADDRESS=
COMMISSIONER_EMAIL=

# Vercel cron auth. The lineup-reminder cron rejects anything without this
# bearer token. Generate with: openssl rand -hex 32
CRON_SECRET=

# GitHub (the admin "suggest an update" button opens an issue)
# Fine-grained PAT with issues:write. Expires; see memory/project_s36_setup.md.
GITHUB_TOKEN=
GITHUB_OWNER=russelldean
GITHUB_REPO=splitzkrieg

# Instagram Creator API feed. Long-lived token, refreshed every 50 days by a
# launchd cron (see memory/project_instagram_feed.md).
INSTAGRAM_ACCESS_TOKEN=

# Maintenance page. MAINTENANCE_MODE=1 serves it; MAINTENANCE_BYPASS is the
# secret that lets you through. Both unset in normal operation.
MAINTENANCE_MODE=
MAINTENANCE_BYPASS=

# Deliberately NOT listed here, do not add them:
#   DB_CACHE_VERSION: bumping it nukes the whole SQL cache and forces a 15+
#     minute full rebuild against Azure SQL's 30-connection cap. See CLAUDE.md.
#   BUILD_ALL, SMOKE_BASE: per-invocation flags, pass them on the command line.
